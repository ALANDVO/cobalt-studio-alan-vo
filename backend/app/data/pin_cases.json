{
  "provenance": "Hand-labeled examples of this resolver's own rules for machine-learning toolchain pins. The labels were written with the rules, so the score measures whether the implementation still matches those rules. It is not a comparison with another version manager and it is not a trained model.",
  "snapshot": "2026-10-14",
  "cases": [
    {
      "id": "notebook-ui-node-version-wins",
      "node_version": "22.14.0\n",
      "nvmrc": "lts/*",
      "package_json": {"name": "notebook-ui", "engines": {"node": ">=18"}},
      "installed": ["22.14.0", "24.11.0", "26.1.0"],
      "expect_source": "node-version",
      "expect_status": "satisfied",
      "expect_matched": "22.14.0",
      "expect_exit": 0
    },
    {
